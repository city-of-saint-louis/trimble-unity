{
  "compilerOptions": {
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "typedocOptions": {
    "excludeExternals": true,
    "externalPattern": "**/node_modules/**",
    "hideGenerator": true,
    "entryPoints": ["src"],
    "entryPointStrategy": "expand",
    "out": "docs"
  }
}
