{
  "name": "trimble-unity",
  "version": "1.0.0",
  "description": "A Trimble Unity SaaS API wrapper",
  "main": "dist/index.js",
  "umd:main": "dist/index.umd.js",
  "module": "dist/index.m.js",
  "source": "src/index.ts",
  "files": [
    "dist/*"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "microbundle watch",
    "build": "microbundle",
    "test": "mocha -R spec --recursive ./test/ -g ",
    "fulltest": "mocha -R spec --recursive ./test/",
    "docs": "typedoc --tsconfig ./tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/city-of-saint-louis/trimble-unity.git"
  },
  "keywords": [
    "trimble",
    "unity",
    "construct",
    "e-builder",
    "api",
    "wrapper",
    "government",
    "construction",
    "project-management"
  ],
  "author": "City of Saint Louis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/city-of-saint-louis/trimble-unity/issues"
  },
  "homepage": "https://github.com/city-of-saint-louis/trimble-unity",
  "devDependencies": {
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "dotenv": "^17.4.1",
    "microbundle": "^0.15.1",
    "mocha": "^11.7.5",
    "typedoc": "^0.28.18"
  },
  "dependencies": {
    "@types/node": "^25.5.2",
    "axios": "^1.15.0",
    "lodash": "^4.18.1",
    "typescript": "^5.9.3"
  }
}
